# ============================================================================
# MongoDB AI Agent - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
APP_NAME=MongoDB AI Agent
ENVIRONMENT=development  # development, staging, production
DEBUG=false
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# ----------------------------------------------------------------------------
# LLM Provider Configuration
# ----------------------------------------------------------------------------
# Choose default provider: openai or ollama
DEFAULT_LLM_PROVIDER=openai

# OpenAI Configuration (required if using OpenAI)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT=60

# Ollama Configuration (required if using Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TEMPERATURE=0
OLLAMA_TIMEOUT=120

# ----------------------------------------------------------------------------
# MongoDB Configuration
# ----------------------------------------------------------------------------
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017

# MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

MONGODB_DATABASE=sample_mflix
MONGODB_COLLECTION=movies
MONGODB_MAX_POOL_SIZE=10
MONGODB_TIMEOUT_MS=5000

# ----------------------------------------------------------------------------
# Checkpointer Configuration
# ----------------------------------------------------------------------------
# Checkpointer type: memory, sqlite, postgres
CHECKPOINTER_TYPE=sqlite
CHECKPOINTER_SQLITE_PATH=./data/checkpoints.db

# PostgreSQL checkpointer (if using postgres)
# CHECKPOINTER_POSTGRES_URI=postgresql://user:password@localhost:5432/checkpoints

# ----------------------------------------------------------------------------
# Agent Configuration
# ----------------------------------------------------------------------------
MAX_CONVERSATION_TURNS=10
ENABLE_STREAMING=true

# ----------------------------------------------------------------------------
# Advanced Settings
# ----------------------------------------------------------------------------
# Retry configuration
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2

# Rate limiting
MAX_REQUESTS_PER_MINUTE=60

# Logging
LOG_FILE_PATH=./logs/agent.log
LOG_FORMAT=json  # json or text
